# The tour of the editor window.

tour-label = The tour of the editor
tour-count = Step { $step } of { $count }
tour-skip = Skip the tour
tour-back = Back
tour-next = Next
tour-done = Done
tour-view-title = The Scene view
tour-view-text = The scene through the editor camera. Drag with the right button to look, use W A S D to fly, and press an entity to select it.
tour-hierarchy-title = The hierarchy
tour-hierarchy-text = Each entity of the scene in its tree. Drag a row to change its parent; the + button makes a new entity.
tour-inspector-title = The inspector
tour-inspector-text = The components of the selected entities. Each change is one step of the history (⌘Z).
tour-project-title = The Project panel
tour-project-text = The files and the assets of the project. Drop a file here to import it, and drag an asset into the scene.
tour-timeline-title = The timeline
tour-timeline-text = The sequence of the scene: its tracks, its keys and the clock. Play it with ⌘P.
tour-search-title = The search box
tour-search-text = ⌘K finds each command, entity, asset and docs page, and asks the agent. Help → Take the tour shows this tour again.
