{
  "name": "@scenity/editor",
  "license": "Apache-2.0",
  "author": "Leonardo Amoroso Custodio",
  "version": "0.0.0",
  "description": "The Scenity editor: the scene page with its edit mode, the play window of the player and the dev server plugins of `scenity dev`. It also holds the editor core of the lab page for the editor faces of plugins. The lab page, its tests and its tools stay in the checkout.",
  "type": "module",
  "files": [
    "src",
    "scene.html",
    "hub.html",
    "player/play.html",
    "vite.scene.config.ts",
    "scripts/assetApi.ts",
    "scripts/assetApiServer.ts",
    "scripts/assetReload.ts",
    "scripts/assetsModule.ts",
    "scripts/labsCsp.ts",
    "scripts/labsFs.ts",
    "scripts/projects.ts",
    "scripts/projectsFile.ts",
    "scripts/sceneProject.ts",
    "scripts/sceneProjectPlugins.ts",
    "scripts/sceneSave.ts",
    "scripts/scenityDeps.ts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonardocustodio/scenity.git",
    "directory": "apps/editor"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./studio": "./src/studio/extensions/api.ts",
      "./core/*.vue": "./src/core/*.vue",
      "./core/*": "./src/core/*.ts",
      "./vite.scene.config": "./vite.scene.config.ts",
      "./package.json": "./package.json"
    }
  },
  "exports": {
    "./studio": "./src/studio/extensions/api.ts",
    "./core/*.vue": "./src/core/*.vue",
    "./core/*": "./src/core/*.ts",
    "./scripts/*": "./scripts/*.ts",
    "./tests/*": "./tests/*.ts",
    "./playwright.config": "./playwright.config.ts",
    "./playwright.gallery.config": "./playwright.gallery.config.ts",
    "./vite.config": "./vite.config.ts",
    "./vite.scene.config": "./vite.scene.config.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && bunx --bun vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && bun scripts/typecheckPlugins.ts",
    "e2e": "bunx --bun playwright test",
    "test:gallery": "bunx --bun playwright test -c playwright.gallery.config.ts",
    "test:components": "bunx --bun vitest run",
    "dev:scene": "bunx --bun vite --config vite.scene.config.ts",
    "build:scene": "bunx --bun vite build --config vite.scene.config.ts --outDir dist-scene --emptyOutDir"
  },
  "dependencies": {
    "@scenity/assets": "workspace:*",
    "@scenity/bridge": "workspace:*",
    "@scenity/character": "workspace:*",
    "@scenity/cli": "workspace:*",
    "@scenity/editor-core": "workspace:*",
    "@scenity/i18n": "workspace:*",
    "@scenity/labs-platform": "workspace:*",
    "@scenity/player": "workspace:*",
    "@scenity/render": "workspace:*",
    "@scenity/rules": "workspace:*",
    "@scenity/runtime": "workspace:*",
    "@scenity/runtime-dev": "workspace:*",
    "@scenity/scene": "workspace:*",
    "@scenity/tokens": "workspace:*",
    "@scenity/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dockview-vue": "catalog:",
    "lucide-vue-next": "1.0.0",
    "tailwindcss": "catalog:",
    "three": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/vue": "catalog:",
    "@types/bun": "catalog:",
    "@types/three": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:",
    "zod": "4.6.5"
  }
}
