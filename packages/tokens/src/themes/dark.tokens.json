        "changed": {
          "$type": "color",
          "$value": "{color.status.caution}"
        },
        "removed": {
          "$type": "color",
          "$value": "{color.status.negative}"
        }
      },
      "axis": {
        "x": {
          "$type": "color",
          "$value": "{color.red.400}"
        },
        "y": {
          "$type": "color",
          "$value": "{color.green.400}"
        },
        "z": {
          "$type": "color",
          "$value": "{color.blue.400}"
        }
      },
      "rule": {
        "ok": {
          "$type": "color",
          "$value": "{color.status.positive}"
        },
        "fail": {
          "$type": "color",
          "$value": "{color.status.negative}"
        },
        "known": {
          "$type": "color",
          "$value": "{color.status.caution}"
        },
        "na": {
          "$type": "color",
          "$value": "{color.status.neutral}"
        }
      },
      "overlay": {
        "surface": {
          "$type": "color",
          "$value": "{color.surface.overlay}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.border.strong}"
        }
      },
      "grid": {
        "minor": {
          "$type": "color",
          "$value": "{color.border.subtle}"
        },
        "major": {
          "$type": "color",
          "$value": "{color.border.strong}"
        }
      },
      "helper": {
        "$type": "color",
        "$value": "{color.text.secondary}"
      }
