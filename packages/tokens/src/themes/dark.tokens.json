      "play": {
        "$type": "color",
        "$value": "{color.status.attention}"
      },
      "prefab": {
        "$type": "color",
        "$value": "{color.cyan.400}"
      },
      "override-bar": {
        "$type": "color",
        "$value": "{color.cyan.400}"
      },
      "agent": {
        "1": {
          "$type": "color",
          "$value": "{color.violet.400}"
        },
        "2": {
          "$type": "color",
          "$value": "{color.lime.300}"
        },
        "3": {
          "$type": "color",
          "$value": "{color.rose.200}"
        },
        "4": {
          "$type": "color",
          "$value": "{color.orange.300}"
        },
        "5": {
          "$type": "color",
          "$value": "{color.paper.50}"
        },
        "6": {
          "$type": "color",
          "$value": "{color.fuchsia.400}"
        }
      },
      "change": {
        "added": {
          "$type": "color",
          "$value": "{color.status.positive}"
