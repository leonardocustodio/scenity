    "card": {
      "$type": "dimension",
      "$value": "{radius.24}"
    },
    "pill": {
      "$type": "dimension",
      "$value": "{radius.full}"
    },
    "button": {
      "$type": "dimension",
      "$value": "{radius.full}"
    }
