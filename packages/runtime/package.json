{
  "name": "@scenity/runtime",
  "license": "Apache-2.0",
  "author": "Leonardo Amoroso Custodio",
  "version": "0.0.0",
  "description": "The runtime of Scenity: the host client, the worker, the protocol, SceneCore, the scene builder, the systems, the plugin host and the clock.",
  "type": "module",
  "files": [
    "src",
    "schema",
    "README.md"
  ],
  "repository": {
    "type": "git",
