{
  "name": "@scenity/ui",
  "license": "Apache-2.0",
  "author": "Leonardo Amoroso Custodio",
  "version": "0.0.0",
  "description": "Design-system components of Scenity (from CodeBlue): Reka UI primitives, the shadcn-vue components and the accessibility parts. The domain components are in the plugins.",
  "type": "module",
  "files": [
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonardocustodio/scenity.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/ui/*/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./i18n/en-US.ftl": "./src/i18n/en-US.ftl",
    "./i18n/pt-BR.ftl": "./src/i18n/pt-BR.ftl"
  },
  "scripts": {
    "test:components": "bunx --bun vitest run",
    "test": "bun test ./tests"
  },
  "dependencies": {
    "@scenity/i18n": "workspace:*",
    "@scenity/tokens": "workspace:*",
    "@vueuse/core": "14.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-vue-next": "1.0.0",
    "reka-ui": "2.10.5",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@testing-library/vue": "catalog:",
    "@types/bun": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "vitest": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "vite": "catalog:"
  }
}
